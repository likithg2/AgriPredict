{
  "kn:e15b117ec348128b0e83cbf4ede5f547": "ಕೋರ್ ಇಂಜಿನಿಯರಿಂಗ್ ಫ್ರೇಮ್ವರ್ಕ್",
  "kn:617995f05e1e98dddf0a91b5aa3db093": "ಯೋಜನೆಯ ಜೀವನಚಕ್ರ",
  "kn:c8216ab9345e50c4de672886c1ea8bdf": "ಸಿಸ್ಟಮ್ ಆರ್ಕಿಟೆಕ್ಚರ್ ಮಾದರಿ",
  "kn:c55516e0feedeb952bb4304393b05c29": "ಬ್ಯಾಕೆಂಡ್-ಆಸ್-ಎ-ಸರ್ವಿಸ್ (BaaS) ಮೈಕ್ರೋ-ಫ್ರೇಮ್‌ವರ್ಕ್",
  "kn:f66e03fb71c4a3a1323fc48a458d4080": "ಡೇಟಾ ಇಂಟರ್ಸೆಪ್ಶನ್ ಗೇಟ್ವೇ",
  "kn:f61115c503ef25f3640f260497bab962": "FastAPI ಮೈಕ್ರೊ ಸರ್ವಿಸ್ ರೂಟರ್ ಎಂಡ್‌ಪಾಯಿಂಟ್‌ಗಳು",
  "kn:e011bd4394698adc806ddb06f24713f3": "ಟ್ರೀ-ಸ್ಟ್ರಕ್ಚರ್ ಸಾಫ್ಟ್ ಎನ್ಸೆಂಬಲ್ಸ್ (XGBoost + RF + GBR)",
  "kn:b70bd1da5cadfd2c849aad6f46269dcf": "ಕಾರ್ಯಾಚರಣಾ ಉಪವ್ಯವಸ್ಥೆಯ ನಿಯೋಜನೆಗಳು",
  "kn:5ade46509f06df3385b364bb3ebf1529": "ML ಪೈಪ್‌ಲೈನ್ ಮತ್ತು ಲಾಭದ ಎಂಜಿನ್ ಲೀಡ್ (ನಿಮ್ಮ ಭಾಗ)",
  "kn:2813f902e7d4a23b1918eb80ad0730c3": "ಡೀಪ್ ಲರ್ನಿಂಗ್ ಕಂಪ್ಯೂಟರ್ ವಿಷನ್ ಸಿಸ್ಟಮ್ಸ್",
  "kn:7c2837daa81bd6d17c136ad41a5401b7": "ಬಾಕಿ ಉಳಿದಿರುವ ಏಕೀಕರಣ",
  "kn:09d02a6c818b1c689237f204e2ca1b5c": "BaaS API ಗೇಟ್‌ವೇ ಮತ್ತು ಮೈಕ್ರೋ ಸರ್ವೀಸಸ್ ಮೂಲಸೌಕರ್ಯ",
  "kn:05d43008b0735a3c82ab0c4d37f61745": "ನಿಯೋಜನೆಗೆ ಸಿದ್ಧವಾಗಿದೆ",
  "kn:483e2d9077c8826ac453cf4a87e07ca2": "ಡೇಟಾಬೇಸ್ ಮ್ಯಾನೇಜ್‌ಮೆಂಟ್ ಸಿಸ್ಟಮ್ಸ್ ಮತ್ತು ಕ್ಲೈಂಟ್ ಫ್ರಂಟೆಂಡ್ UI",
  "kn:8b1947fc7eb19a519480e793ea117c38": "ಲಿಂಕ್ಡ್ ಕಾನ್ಫಿಗರೇಶನ್",
  "kn:3cdc0958b61bd09615b4c79b5bda22d7": "ಸಿಸ್ಟಮ್ ನ್ಯಾವಿಗೇಷನ್ ಕ್ರಿಯೆ",
  "kn:b16e461a648f914412337ace45e34cba": "ಸಕ್ರಿಯ 12-ವೈಶಿಷ್ಟ್ಯದ ಯಂತ್ರ ಕಲಿಕೆ ಹಾಳಾಗುವಿಕೆಯ ಮುನ್ಸೂಚನೆ ಎಂಜಿನ್ ಮಾಡ್ಯೂಲ್ ಪುಟಕ್ಕೆ ಮನಬಂದಂತೆ ಹೆಜ್ಜೆ ಹಾಕಲು ಎಡ ಸೈಡ್‌ಬಾರ್ ಮೆನುವನ್ನು ವಿಸ್ತರಿಸಿ.",
  "kn:464d29d28d317f40d321b95b723be519": "BaaS ಜೊತೆಗೆ AI-ಚಾಲಿತ ಕೊಯ್ಲಿನ ನಂತರದ ನಷ್ಟದ ಮುನ್ಸೂಚನೆ",
  "kn:7a90147102ab7b740ad566c401a3e021": "ಬೆಂಗಳೂರು ಇನ್‌ಸ್ಟಿಟ್ಯೂಟ್ ಆಫ್ ಟೆಕ್ನಾಲಜಿ — ಕಂಪ್ಯೂಟರ್ ಸೈನ್ಸ್ ಮತ್ತು ಇಂಜಿನಿಯರಿಂಗ್ ವಿಭಾಗ",
  "kn:a66f7ca3ad00671ae800a5ebcf747b88": "ಅಗ್ರಿಕಲ್ಚರಲ್ ಇಂಟೆಲಿಜೆನ್ಸ್ ಸಿಸ್ಟಮ್ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್",
  "kn:949144bf2ddd611a8693c8564b498105": "ಈ ವಿಕೇಂದ್ರೀಕೃತ ಬಹು-ಶ್ರೇಣೀಕೃತ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಯಂತ್ರ ಕಲಿಕೆಯ ಜೈವಿಕ ಭೌತಿಕ ಮುನ್ಸೂಚನೆ, ಕಂಪ್ಯೂಟರ್ ದೃಷ್ಟಿ ಗುಣಮಟ್ಟದ ವಿಶ್ಲೇಷಣೆ ಮತ್ತು ನೈಜ-ಸಮಯದ ಸಾರಿಗೆ ಲಾಜಿಸ್ಟಿಕ್ಸ್ ಮೌಲ್ಯಮಾಪನವನ್ನು ಸಮಗ್ರ ಬ್ಯಾಕೆಂಡ್-ಆಸ್-ಎ-ಸರ್ವಿಸ್ (BaaS) ವಿನ್ಯಾಸ ರಚನೆಯೊಳಗೆ ವಿತರಿಸುತ್ತದೆ.",
  "kn:effdf40773ec63e276265ef33d44c3c5": "ಬ್ಯಾಚ್ 2023 - 2027",
  "kn:cbce8e8740c6021186c6e2f399ff452d": "ಕೋರ್ ಅಪ್ಲೈಡ್ ಮಾಡೆಲ್‌ಗಳು",
  "kn:23fbf516c09e36da28af27a254cbba8d": "ಕಾರ್ಯಾಚರಣಾ ಉಪವ್ಯವಸ್ಥೆಗಳು",
  "kn:37c9ff0c20aa4d3a589ba25cdd4c0eaf": "ಲಾಗಿನ್ / ನೋಂದಣಿ",
  "kn:aede2b1349fd2bc18ab74ca5586dfefe": "ಕರ್ನಾಟಕ ಅಗ್ರಿಕಲ್ಚರಲ್ ಇಂಟೆಲಿಜೆನ್ಸ್ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ - ಸುರಕ್ಷಿತ ಪ್ರವೇಶ ಗೇಟ್‌ವೇ",
  "kn:99dea78007133396a7b8ed70578ac6ae": "ಲಾಗಿನ್ ಮಾಡಿ",
  "kn:d67850bd126f070221dcfd5fa6317043": "ಸೈನ್ ಅಪ್ ಮಾಡಿ",
  "hi:aede2b1349fd2bc18ab74ca5586dfefe": "कर्नाटक कृषि आसूचना मंच - सुरक्षित पहुंच गेटवे",
  "hi:99dea78007133396a7b8ed70578ac6ae": "लॉग इन करें",
  "hi:d67850bd126f070221dcfd5fa6317043": "साइन अप करें",
  "hi:8cf04a9734132302f96da8e113e80ce5": "घर",
  "hi:3e97cc0517accc838095a6e66595e750": "एमएल भविष्यवाणी",
  "hi:96cd12ff764351a64148dabad6f4bcf5": "गोदाम प्रबंधक",
  "hi:2938c7f7e560ed972f8a4f68e80ff834": "डैशबोर्ड",
  "hi:01a2d66ab2ea0e18cc5573f315f72f53": "भविष्यवाणी इतिहास",
  "hi:37c9ff0c20aa4d3a589ba25cdd4c0eaf": "लॉगइन/रजिस्टर करें",
  "hi:04c951c0d5014c95384f2a3a00c0be39": "आप लॉग इन हैं",
  "hi:72c131d9d231d2b322504fd6ee2f6fdb": "कर्नाटक कृषि आसूचना मंच में आपका पुनः स्वागत है",
  "hi:0323de4f66a1700e2173e9bcdce02715": "लॉग आउट",
  "hi:ac01ce8d1d6d3864589cd364af2b6300": "एमएल भविष्यवाणी, किसान डैशबोर्ड, या वेयरहाउस मैनेजर पर नेविगेट करने के लिए साइडबार का उपयोग करें।",
  "kn:8cf04a9734132302f96da8e113e80ce5": "ಮನೆ",
  "kn:3e97cc0517accc838095a6e66595e750": "ML ಭವಿಷ್ಯ",
  "kn:96cd12ff764351a64148dabad6f4bcf5": "ವೇರ್ಹೌಸ್ ಮ್ಯಾನೇಜರ್",
  "kn:2938c7f7e560ed972f8a4f68e80ff834": "ಡ್ಯಾಶ್‌ಬೋರ್ಡ್",
  "kn:01a2d66ab2ea0e18cc5573f315f72f53": "ಭವಿಷ್ಯ ಇತಿಹಾಸ",
  "kn:04c951c0d5014c95384f2a3a00c0be39": "ನೀವು ಲಾಗ್ ಇನ್ ಆಗಿರುವಿರಿ",
  "kn:72c131d9d231d2b322504fd6ee2f6fdb": "ಕರ್ನಾಟಕ ಕೃಷಿ ಗುಪ್ತಚರ ವೇದಿಕೆಗೆ ಮರಳಿ ಸ್ವಾಗತ",
  "kn:0323de4f66a1700e2173e9bcdce02715": "ಲಾಗ್ಔಟ್",
  "kn:ac01ce8d1d6d3864589cd364af2b6300": "ML ಪ್ರಿಡಿಕ್ಷನ್, ಫಾರ್ಮರ್ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್ ಅಥವಾ ವೇರ್‌ಹೌಸ್ ಮ್ಯಾನೇಜರ್‌ಗೆ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಲು ಸೈಡ್‌ಬಾರ್ ಬಳಸಿ.",
  "kn:d5f26ac5f5bd644c9518c19a3b7de9fa": "ನಿಮ್ಮ ಎಲ್ಲಾ ಬೆಳೆ ಹಾಳಾಗುವಿಕೆಯ ವಿಶ್ಲೇಷಣೆ ರನ್‌ಗಳ ಸಂಪೂರ್ಣ ದಾಖಲೆ",
  "kn:230d3dfcef7b834d4e73e449a34e02a2": "ಕ್ರಾಪ್ ಮೂಲಕ ಫಿಲ್ಟರ್ ಮಾಡಿ",
  "kn:b2707a7fc3dc210dd22dbcde31c16103": "ಜಿಲ್ಲೆಯ ಪ್ರಕಾರ ಫಿಲ್ಟರ್ ಮಾಡಿ",
  "kn:193cfc9be3b995831c6af2fea6650e60": "ಪುಟ",
  "kn:0276c7205816a6215635808c90cff78a": "ಪುಟವನ್ನು ತೋರಿಸಲಾಗುತ್ತಿದೆ",
  "kn:8bf8854bebe108183caeb845c7676ae4": "ನ",
  "kn:fc1b739fe5aed07a30bdefa8ad6c1b71": "ಒಟ್ಟು ಭವಿಷ್ಯವಾಣಿಗಳು)",
  "kn:9d7e24acec944945bcce0a5f122172b4": "ಯಾವುದೇ ಮುನ್ಸೂಚನೆಗಳು ಕಂಡುಬಂದಿಲ್ಲ. ನಿಮ್ಮ ಇತಿಹಾಸವನ್ನು ಇಲ್ಲಿ ನೋಡಲು **ML Prediction** ಪುಟದಲ್ಲಿ ಕೆಲವು ಮುನ್ನೋಟಗಳನ್ನು ರನ್ ಮಾಡಿ.",
  "kn:8bf7aa45eea83881ca9052ac2d7a8025": "ರೈತ",
  "kn:83218ac34c1834c26781fe4bde918ee4": "ಸ್ವಾಗತ",
